{
  "name": "parhelion-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Parhelion Alpha - World first area (幻日谷) blockout generator + Three.js viewer",
  "scripts": {
    "build:world": "tsx tools/build-world.ts",
    "build:britain": "tsx tools/build-britain.ts",
    "build:blacksail": "tsx tools/build-blacksail.ts",
    "build:winter": "tsx tools/build-winter.ts",
    "build:kyoto": "tsx tools/build-kyoto.ts",
    "build:character": "tsx tools/build-character.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test validation/*.test.ts",
    "test:browser": "node validation/browser.mjs",
    "test:ci": "node --import tsx --test --test-concurrency=2 validation/*.test.ts"
  },
  "dependencies": {
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.16"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "jsdom": "^30.1.3",
    "meshoptimizer": "^1.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}

{
  "name": "parhelion-arena-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Parhelion Alpha - Arena game runtime (client + Colyseus server + shared deterministic rules) on top of the ASTER map in ../arena",
  "scripts": {
    "dev": "vite",
    "server": "tsx watch server/index.ts",
    "server:once": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@colyseus/core": "0.18.23",
    "@colyseus/sdk": "0.18.6",
    "@colyseus/ws-transport": "0.18.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
